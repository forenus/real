[Unit]
Description=매물 추적기 Cloudflare 터널 (tunnel.js)
After=real-server.service network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=TZ=Asia/Seoul
ExecStart=/usr/bin/node __DIR__/tunnel.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
